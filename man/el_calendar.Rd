      events(d)
      update_el_calendar(session, "plan", replace = d[i, ])
    })
    observeEvent(input$plan_delete, {
      events(events()[events()$id != input$plan_delete$id, ])
      update_el_calendar(session, "plan", delete = input$plan_delete$id)
