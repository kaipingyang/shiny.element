      new <- data.frame(
        id = max(events()$id) + 1L,
        date = input$plan_add$date,
        title = input$plan_add$title,
        type = input$plan_add$type
      )
      events(rbind(events(), new))
      update_el_calendar(session, "plan", insert = new)
