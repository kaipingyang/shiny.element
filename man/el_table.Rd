if (interactive()) {
  library(shiny)
  library(shiny.element)
  ui <- el_page(
    el_table("my_table", data = head(iris, 5), selection = TRUE),
    el_button("reload", "Show more rows"),
    verbatimTextOutput("selected_rows")
